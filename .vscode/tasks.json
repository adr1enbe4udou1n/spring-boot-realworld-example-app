{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Spotless: Apply",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "args": ["spotlessApply"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Spotless: Check",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "args": ["spotlessCheck"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
